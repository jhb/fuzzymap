def init_lang():
    """Sprache vor dem Laden: Browsersprache (de* = Deutsch, sonst Englisch); gespeicherte Wahl hat Vorrang (load)."""
    try:
        nav = str(window.navigator.language or "de").lower()
    except Exception:
        nav = "de"
    LANG["v"] = "de" if nav.startswith("de") else "en"


def apply_static():
    """Übersetzt die statischen Texte in index.html (data-i18n*, Hilfe aus <template id="help-en">)."""
    document.documentElement.lang = LANG["v"]
    for attr_name, store in (("data-i18n", "innerHTML"), ("data-i18n-title", "title"),
                             ("data-i18n-aria", "aria-label"), ("data-i18n-ph", "placeholder")):
        els = document.querySelectorAll("[" + attr_name + "]")
        for i in range(els.length):
            e = els.item(i)
            key = str(e.getAttribute(attr_name))
            orig = "data-de-" + store
            if not e.hasAttribute(orig):
                e.setAttribute(orig, e.innerHTML if store == "innerHTML" else (e.getAttribute(store) or ""))
            de = str(e.getAttribute(orig))
            val = EN_STATIC.get(key, de) if is_en() else de
            if store == "innerHTML":
                e.innerHTML = val
            else:
                e.setAttribute(store, val)
    hb = document.querySelector("#help .help-body")
    tpl = el("help-en")
    if not is_none(hb) and not is_none(tpl):
        if not hb.hasAttribute("data-de-ready"):
            HELP_DE["html"] = str(hb.innerHTML)
            hb.setAttribute("data-de-ready", "1")
        hb.innerHTML = str(tpl.innerHTML) if is_en() else HELP_DE["html"]
    btns = document.querySelectorAll("[data-action=lang]")
    for i in range(btns.length):
        b = btns.item(i)
        b.setAttribute("aria-pressed", "true" if attr(b, "data-v") == LANG["v"] else "false")


HELP_DE = {"html": ""}


def a_lang(b, e):
    v = attr(b, "data-v")
    if v not in ("de", "en") or v == LANG["v"]:
        return
    LANG["v"] = v
    S["settings"]["lang"] = v
    save()
    apply_static()
    render_all()
    render_hint()


ACTIONS["lang"] = a_lang


def main():
    init_lang()
    load()
    apply_static()
    svg = el("canvas")
    listen(svg, "pointerdown", on_down)
    listen(svg, "pointermove", on_move)
    listen(svg, "pointerup", on_up)
    listen(svg, "pointercancel", on_up)
    listen(svg, "dblclick", on_dbl)
    listen(svg, "wheel", on_wheel, {"passive": False})
    listen(document, "click", on_click)
    listen(document, "input", on_input)
    listen(document, "change", on_change)
    # ausstehendes Speichern nicht verlieren: visibilitychange feuert auch beim Schließen bzw. Wechseln des Tabs
    listen(document, "visibilitychange", flush_save)
    listen(document, "keydown", on_key)
    listen(document, "fullscreenchange", on_fs_change)
    listen(document, "webkitfullscreenchange", on_fs_change)
    listen(document, "fullscreenerror", _fs_denied)
    listen(document, "pointerover", on_over)
    listen(document, "pointerout", on_out)
    listen(el("run-detail"), "pointermove", on_chart_move)
    listen(el("run-detail"), "pointerleave", on_chart_leave)
    listen(document, "pointerdown", on_chart_down)
    sp = el("splitter")
    listen(sp, "pointerdown", on_split_down)
    listen(sp, "pointermove", on_split_move)
    listen(sp, "pointerup", on_split_up)
    listen(sp, "pointercancel", on_split_up)
    listen(sp, "keydown", on_split_key)
    listen(sp, "dblclick", on_split_dbl)
    if S["settings"].get("panelW"):
        set_panel_w(S["settings"]["panelW"])
    listen(el("import-file"), "change", on_import)
    listen(document, "dragover", on_dragover)
    listen(document, "dragleave", on_dragleave)
    listen(document, "drop", on_drop)
    ro = window.ResizeObserver.new(RESIZE)
    ro.observe(el("canvas"))
    ro2 = window.ResizeObserver.new(PANEL_RESIZE)
    ro2.observe(el("run-detail"))
    render_all()
    fit()
    ld = el("loader")
    if not is_none(ld):
        ld.remove()
    try:
        if not is_none(window.navigator.serviceWorker):
            window.navigator.serviceWorker.register("sw.js")
    except Exception:
        pass


try:
    main()
except Exception as ex:
    import sys, io
    buf = io.StringIO()
    sys.print_exception(ex, buf)
    document.body.setAttribute("data-err", buf.getvalue())
    raise
